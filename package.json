{
  "name": "gestao-logistica",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "electron/main.cjs",
  "description": "Gestão local de clientes, sessões, tratamento, impressão e remessas",
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@radix-ui/react-dropdown-menu": "^2.1.24",
    "@radix-ui/react-tooltip": "^1.2.16",
    "exceljs": "^4.4.0",
    "mssql": "^11.0.1"
  },
  "overrides": {
    "uuid": "^11.1.1"
  },
  "scripts": {
    "dev": "concurrently -k \"vite --host 127.0.0.1 --port 8090 --strictPort\" \"wait-on http://127.0.0.1:8090 && electron .\"",
    "build": "tsc --noEmit && vite build",
    "check": "tsc --noEmit && node --check electron/main.cjs && node --check electron/preload.cjs && node --check electron/database.cjs && node --check electron/importer.cjs && node --check electron/siwin.cjs && node --check electron/thunderbird.cjs",
    "capture:ui": "electron tests/capture-ui.cjs",
    "dist": "npm run build && electron-builder --win"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^5.0.0",
    "concurrently": "^9.2.4",
    "electron": "^43.4.1",
    "electron-builder": "^26.15.3",
    "lucide-react": "^0.575.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "typescript": "^5.9.0",
    "vite": "^8.2.2",
    "wait-on": "^9.1.0"
  },
  "build": {
    "appId": "br.com.manoelguimaraes.gestaologistica",
    "productName": "Gestão Logística",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "electron/main.cjs",
      "electron/preload.cjs",
      "electron/database.cjs",
      "electron/importer.cjs",
      "electron/siwin.cjs",
      "electron/thunderbird.cjs",
      "package.json",
      "!node_modules/**/*"
    ],
    "win": {
      "target": "nsis"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    }
  }
}
